diff --git a/kernel/include/ksu_compat.h b/kernel/include/ksu_compat.h
new file mode 100644
index 00000000..fae642e7
--- /dev/null
+++ b/kernel/include/ksu_compat.h
@@ -0,0 +1,71 @@
+#ifndef __KSU_COMPAT_H
+#define __KSU_COMPAT_H
+
+#include <linux/uaccess.h>
+#include <linux/version.h>
+#include <linux/string.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+#include <asm/unistd.h>
+#ifndef SECCOMP_ARCH_NATIVE_NR
+#define SECCOMP_ARCH_NATIVE_NR __NR_syscalls
+#endif
+#ifndef TWA_RESUME
+#define TWA_RESUME true
+#endif
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+static inline ssize_t ksu_strscpy_pad(char *dst, const char *src, size_t count)
+{
+    size_t src_len;
+
+    if (!count)
+        return -E2BIG;
+
+    src_len = strlcpy(dst, src, count);
+    if (src_len >= count)
+        return -E2BIG;
+
+    memset(dst + src_len, 0, count - src_len);
+    return src_len;
+}
+
+#define strscpy_pad(dst, src, count) \
+    ksu_strscpy_pad((dst), (src), (count))
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 8, 0)
+static inline long ksu_copy_from_user_nofault(void *dst, const void __user *src,
+                                              size_t size)
+{
+    unsigned long not_copied;
+
+    pagefault_disable();
+    not_copied = __copy_from_user_inatomic(dst, src, size);
+    pagefault_enable();
+    return not_copied ? -EFAULT : 0;
+}
+
+static inline long ksu_copy_to_user_nofault(void __user *dst, const void *src,
+                                            size_t size)
+{
+    unsigned long not_copied;
+
+    pagefault_disable();
+    not_copied = __copy_to_user_inatomic(dst, src, size);
+    pagefault_enable();
+    return not_copied ? -EFAULT : 0;
+}
+
+#define copy_from_user_nofault(dst, src, size) \
+    ksu_copy_from_user_nofault((dst), (src), (size))
+#define copy_to_user_nofault(dst, src, size) \
+    ksu_copy_to_user_nofault((dst), (src), (size))
+#define copy_to_kernel_nofault(dst, src, size) \
+    probe_kernel_write((dst), (src), (size))
+#define strncpy_from_user_nofault(dst, src, count) \
+    strncpy_from_unsafe((dst), (const void *)(src), (count))
+#endif
+
+#endif
